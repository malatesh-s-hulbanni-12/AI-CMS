{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/pdf/(.*)",
      "dest": "/api/pdf_handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
